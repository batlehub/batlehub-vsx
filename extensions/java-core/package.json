    "menus": {
      "commandPalette": [
        {
          "command": "batlehub.java.dumpClasspath",
          "when": "batlehub.java.active"
        },
        {
          "command": "batlehub.java.run.start",
          "when": "false"
        },
        {
          "command": "batlehub.java.generate.accessors",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.generate.getters",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.generate.setters",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.generate.constructors",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.generate.toString",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.generate.hashCodeEquals",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.generate.delegates",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.generate.override",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.refactor.rename",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.refactor.extractMethod",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.refactor.extractVariable",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.refactor.extractConstant",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.refactor.extractField",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.refactor.inline",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.refactor.changeSignature",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.refactor.organizeImports",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.goto.definition",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.goto.typeDefinition",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.goto.implementations",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.goto.references",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.goto.superImplementation",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.goto.typeHierarchy",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.goto.symbol",
          "when": "editorLangId == java"
        },
        {
          "command": "batlehub.java.goto.workspaceSymbol",
          "when": "editorLangId == java"
        }
      ],
      "editor/context": [
        {
          "submenu": "batlehub.java.generateMenu",
          "group": "1_batlehub@1",
          "when": "resourceLangId == java && batlehub.java.active"
        },
        {
          "submenu": "batlehub.java.refactorMenu",
          "group": "1_batlehub@2",
          "when": "resourceLangId == java && batlehub.java.active"
        },
        {
          "submenu": "batlehub.java.gotoMenu",
          "group": "1_batlehub@3",
          "when": "resourceLangId == java && batlehub.java.active"
        }
      ],
      "batlehub.java.generateMenu": [
        {
          "command": "batlehub.java.generate.accessors",
          "group": "1_accessors@0",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.generate.getters",
          "group": "1_accessors@1",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.generate.setters",
          "group": "1_accessors@2",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.generate.constructors",
          "group": "2_members@3",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.generate.toString",
          "group": "2_members@4",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.generate.hashCodeEquals",
          "group": "2_members@5",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.generate.delegates",
          "group": "2_members@6",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.generate.override",
          "group": "2_members@7",
          "when": "batlehub.java.standard"
        }
      ],
      "batlehub.java.refactorMenu": [
        {
          "command": "batlehub.java.refactor.rename",
          "group": "1_rename@0",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.refactor.extractMethod",
          "group": "2_extract@1",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.refactor.extractVariable",
          "group": "2_extract@2",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.refactor.extractConstant",
          "group": "2_extract@3",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.refactor.extractField",
          "group": "2_extract@4",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.refactor.inline",
          "group": "2_extract@5",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.refactor.changeSignature",
          "group": "2_extract@6",
          "when": "batlehub.java.standard"
        },
        {
          "command": "batlehub.java.refactor.organizeImports",
          "group": "3_imports@7",
          "when": "batlehub.java.standard"
        }
      ],
      "batlehub.java.gotoMenu": [
        {
          "command": "batlehub.java.goto.definition",
          "group": "1_editor@0"
        },
        {
          "command": "batlehub.java.goto.typeDefinition",
          "group": "1_editor@1"
        },
        {
          "command": "batlehub.java.goto.implementations",
          "group": "1_editor@2"
        },
        {
          "command": "batlehub.java.goto.references",
          "group": "1_editor@3"
        },
        {
          "command": "batlehub.java.goto.superImplementation",
          "group": "2_java@4"
        },
        {
          "command": "batlehub.java.goto.typeHierarchy",
          "group": "2_java@5"
        },
        {
          "command": "batlehub.java.goto.symbol",
          "group": "1_editor@6"
        },
        {
          "command": "batlehub.java.goto.workspaceSymbol",
          "group": "1_editor@7"
        }
      ],
      "view/title": [
        {
          "command": "batlehub.java.detect",
          "when": "view == batlehub.java.panel",
          "group": "navigation@1"
        },
        {
          "command": "batlehub.java.runGoal",
          "when": "view == batlehub.java.panel",
          "group": "navigation@2"
        },
        {
          "command": "batlehub.java.showLog",
          "when": "view == batlehub.java.panel",
          "group": "navigation@3"
        },
        {
          "command": "batlehub.java.explorer.refresh",
          "when": "view == batlehub.java.explorer",
          "group": "navigation@1"
        },
        {
          "command": "batlehub.java.dependencyTree",
          "when": "view == batlehub.java.explorer",
          "group": "navigation@2"
        },
        {
          "command": "batlehub.java.inspections.fixAll",
          "when": "view == batlehub.java.inspections && batlehub.java.bundle",
          "group": "navigation@1"
        },
        {
          "command": "batlehub.java.inspections.refresh",
          "when": "view == batlehub.java.inspections",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "batlehub.java.inspections.fixAll",
          "when": "view == batlehub.java.inspections && viewItem =~ /^(rule|file)$/",
          "group": "inline@1"
        }
      ]
    },
    "submenus": [
      {
        "id": "batlehub.java.generateMenu",
        "label": "%menu.generate%"
      },
      {
        "id": "batlehub.java.refactorMenu",
        "label": "%menu.refactor%"
      },
      {
        "id": "batlehub.java.gotoMenu",
        "label": "%menu.goto%"
      }
    ],
    "keybindings": [
      {
        "command": "batlehub.java.refactor.rename",
        "key": "shift+f6",
        "when": "editorTextFocus && editorLangId == java"
      },
      {
        "command": "batlehub.java.generate.accessors",
        "key": "alt+insert",
        "when": "editorTextFocus && editorLangId == java"
      },
      {
        "command": "batlehub.java.goto.superImplementation",
        "key": "ctrl+u",
        "mac": "cmd+u",
        "when": "editorTextFocus && editorLangId == java"
      },
      {
        "command": "batlehub.java.goto.typeHierarchy",
        "key": "ctrl+h",
        "when": "editorTextFocus && editorLangId == java"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "batlehub-java",
          "title": "%view.container%",
          "icon": "media/java.svg"
        }
      ]
    },
    "views": {
      "batlehub-java": [
        {
          "id": "batlehub.java.explorer",
          "name": "%view.explorer%",
          "icon": "media/java.svg",
          "contextualTitle": "%view.explorer%",
          "when": "batlehub.java.active"
        },
        {
          "type": "webview",
          "id": "batlehub.java.panel",
          "name": "%view.panel%",
          "icon": "media/java.svg",
          "contextualTitle": "%view.panel%",
          "when": "batlehub.java.active"
        },
        {
          "id": "batlehub.java.inspections",
          "name": "%view.inspections%",
          "icon": "media/java.svg",
          "contextualTitle": "%view.inspections%",
          "when": "batlehub.java.active"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "batlehub.java.panel",
        "contents": "%view.welcome%",
        "when": "!batlehub.java.active"
      },
      {
        "view": "batlehub.java.inspections",
        "contents": "%view.inspections.welcome%",
        "when": "batlehub.java.active && !batlehub.java.bundle"
      }
    ],
    "taskDefinitions": [
      {
        "type": "batlehub-java",
        "required": [
          "tool",
          "goal"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "maven",
              "gradle"
            ],
            "description": "%task.tool%"
          },
          "goal": {
            "type": "string",
            "description": "%task.goal%"
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "%task.profiles%"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "%task.args%"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "batlehub-maven",
        "owner": "java",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^\\[(ERROR|WARNING)\\]\\s+(.+?\\.java):\\[(\\d+),(\\d+)\\]\\s+(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    ],
    "javaExtensions": [
      "./jdt/batlehub-jdt-core.jar"
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs && npm run api",
    "watch": "node esbuild.mjs --watch",
    "api": "tsc -p tsconfig.api.json && mv api-types.d.ts api.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src test media && prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"media/**/*.ts\" esbuild.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"media/**/*.ts\" esbuild.mjs",
    "test": "vitest run",
    "test:host": "tsc -p test-host/tsconfig.json && vscode-test",
    "package": "node esbuild.mjs && vsce package --no-dependencies --skip-license -o java-core.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsonc-parser": "^3.3.1",
    "mocha": "^11.7.1",
    "oxlint": "^1.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
