                "items": {
                  "type": "object",
                  "oneOf": [
                    {
                      "required": [
                        "task"
                      ],
                      "properties": {
                        "task": {
                          "type": "string",
                          "description": "%debug.run.task%"
                        },
                        "ready": {
                          "type": "object",
                          "description": "%debug.run.probe%",
                          "additionalProperties": false,
                          "properties": {
                            "port": {
                              "type": "integer",
                              "description": "%debug.run.probe.port%"
                            },
                            "http": {
                              "type": "string",
                              "description": "%debug.run.probe.http%"
                            },
                            "status": {
                              "type": "integer",
                              "description": "%debug.run.probe.status%"
                            },
                            "log": {
                              "type": "string",
                              "description": "%debug.run.probe.log%"
                            },
                            "exit": {
                              "type": "integer",
                              "description": "%debug.run.probe.exit%"
                            },
                            "timeoutMs": {
                              "type": "integer",
                              "default": 60000
                            },
                            "intervalMs": {
                              "type": "integer",
                              "default": 500
                            }
                          }
                        }
                      }
                    },
                    {
                      "required": [
                        "launch"
                      ],
                      "properties": {
                        "launch": {
                          "type": "string",
                          "description": "%debug.run.launch%"
                        },
                        "ready": {
                          "type": "object",
                          "description": "%debug.run.probe%",
                          "additionalProperties": false,
                          "properties": {
                            "port": {
                              "type": "integer",
                              "description": "%debug.run.probe.port%"
                            },
                            "http": {
                              "type": "string",
                              "description": "%debug.run.probe.http%"
                            },
                            "status": {
                              "type": "integer",
                              "description": "%debug.run.probe.status%"
                            },
                            "log": {
                              "type": "string",
                              "description": "%debug.run.probe.log%"
                            },
                            "exit": {
                              "type": "integer",
                              "description": "%debug.run.probe.exit%"
                            },
                            "timeoutMs": {
                              "type": "integer",
                              "default": 60000
                            },
                            "intervalMs": {
                              "type": "integer",
                              "default": 500
                            }
                          }
                        }
                      }
                    },
                    {
                      "required": [
