        },
        "configurationSnippets": [
          {
            "label": "BatleHub: Orchestrated run (steps)",
            "description": "%debug.run.snippet%",
            "body": {
              "type": "batlehub-run",
              "request": "launch",
              "name": "Orchestrated run",
              "steps": [
                {
                  "process": [
                    "jwebserver",
                    "-p",
                    "8000"
                  ],
                  "memoryMiB": 128,
                  "ready": {
                    "port": 8000
                  }
                }
              ]
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "batlehub-java",
        "required": [
          "tool",
          "goal"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "maven",
              "gradle"
            ],
            "description": "%task.tool%"
          },
          "goal": {
            "type": "string",
            "description": "%task.goal%"
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "%task.profiles%"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "%task.args%"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "batlehub-maven",
        "owner": "java",
        "fileLocation": [
          "absolute"
        ],
        "pattern": {
          "regexp": "^\\[(ERROR|WARNING)\\]\\s+(.+?\\.java):\\[(\\d+),(\\d+)\\]\\s+(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    ],
    "javaExtensions": [
      "./jdt/batlehub-jdt-core.jar"
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.batlehub/java/inspections.json"
        ],
        "url": "./schema/java-inspections.schema.json"
      },
      {
        "fileMatch": [
          "**/.batlehub/java/project.json"
        ],
        "url": "./schema/java-project.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs && npm run api",
    "watch": "node esbuild.mjs --watch",
    "api": "tsc -p tsconfig.api.json && mv api-types.d.ts api.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src test media && prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"media/**/*.ts\" esbuild.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"media/**/*.ts\" esbuild.mjs",
    "test": "vitest run",
    "test:host": "tsc -p test-host/tsconfig.json && vscode-test",
    "package": "node esbuild.mjs && vsce package --no-dependencies --skip-license -o java-core.vsix"
  },
  "devDependencies": {
    "@batlehub/java-rules": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsonc-parser": "^3.3.1",
    "mocha": "^11.7.1",
    "oxlint": "^1.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
