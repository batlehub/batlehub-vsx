                        },
                        "cwd": {
                          "type": "string"
                        },
                        "env": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "memoryMiB": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "%debug.run.memoryMiB%"
                        },
                        "ready": {
                          "type": "object",
                          "description": "%debug.run.probe%",
                          "additionalProperties": false,
                          "properties": {
                            "port": {
                              "type": "integer",
                              "description": "%debug.run.probe.port%"
                            },
                            "http": {
                              "type": "string",
                              "description": "%debug.run.probe.http%"
                            },
                            "status": {
                              "type": "integer",
                              "description": "%debug.run.probe.status%"
                            },
                            "log": {
                              "type": "string",
                              "description": "%debug.run.probe.log%"
