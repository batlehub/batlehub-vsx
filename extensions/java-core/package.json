{
  "name": "java-core",
  "displayName": "BatleHub Java",
  "description": "One core for Java in VS Code: the JDK that runs, the container's memory, run configurations, the Maven and Gradle integration and an IDEA-style menu — over the Red Hat language stack (RFC 0001).",
  "version": "0.1.0",
  "publisher": "batlehub",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/batleforc/batlehub-vsx"
  },
  "homepage": "https://github.com/batleforc/batlehub-vsx/tree/main/extensions/java-core",
  "icon": "media/java.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "java",
    "jdk",
    "maven",
    "gradle",
    "batlehub",
    "intellij"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "workspaceContains:pom.xml",
    "workspaceContains:*/pom.xml",
    "workspaceContains:build.gradle",
    "workspaceContains:*/build.gradle",
    "workspaceContains:build.gradle.kts",
    "workspaceContains:*/build.gradle.kts",
    "workspaceContains:settings.gradle",
    "workspaceContains:settings.gradle.kts",
    "workspaceContains:.classpath",
    "onLanguage:java"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%",
      "restrictedConfigurations": [
        "batlehub.java.jdk.installVia",
        "batlehub.java.maven.configurations",
        "batlehub.java.registry.enabled",
        "batlehub.java.registry.url"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "BatleHub Java",
      "properties": {
        "batlehub.java.jdk.sources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mise",
              "sdkman",
              "env",
              "wellKnown"
            ]
          },
          "default": [
            "mise",
            "sdkman",
            "env",
            "wellKnown"
          ],
          "markdownDescription": "%config.jdk.sources%",
          "scope": "machine-overridable"
        },
        "batlehub.java.jdk.installVia": {
          "type": "string",
          "enum": [
            "auto",
            "mise",
            "sdkman",
            "none"
          ],
          "markdownDescription": "%config.jdk.installVia%",
          "scope": "machine-overridable"
        },
        "batlehub.java.jdk.matchProject": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.jdk.matchProject%",
          "scope": "resource"
        },
        "batlehub.java.generate.getterPrefix": {
          "type": "string",
          "default": "get",
          "markdownDescription": "%config.generate.getterPrefix%",
          "scope": "resource"
        },
        "batlehub.java.generate.booleanPrefix": {
          "type": "string",
          "default": "is",
          "markdownDescription": "%config.generate.booleanPrefix%",
          "scope": "resource"
        },
        "batlehub.java.generate.fluentSetters": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.generate.fluentSetters%",
          "scope": "resource"
        },
        "batlehub.java.generate.finalFields": {
          "type": "string",
          "enum": [
            "keepSetters",
            "skipSetters"
          ],
          "default": "keepSetters",
          "markdownDescription": "%config.generate.finalFields%",
          "scope": "resource"
        },
        "batlehub.java.report.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.report.url%",
          "scope": "machine-overridable"
        },
        "batlehub.java.log.level": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "markdownDescription": "%config.log.level%",
          "scope": "machine-overridable"
        },
        "batlehub.java.statusBar.items": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "boolean"
          },
          "markdownDescription": "%config.statusBar.items%",
          "scope": "machine-overridable"
        },
        "batlehub.java.resources.warnBelow": {
          "type": "string",
          "default": "2Gi",
          "markdownDescription": "%config.resources.warnBelow%",
          "scope": "machine-overridable"
        },
        "batlehub.java.inspections.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.inspections.enabled%",
          "scope": "resource"
        },
        "batlehub.java.inspections.severityOverrides": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info",
              "hint",
              "off"
            ]
          },
          "markdownDescription": "%config.inspections.severityOverrides%",
          "scope": "resource"
        },
        "batlehub.java.maven.configurations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "settingsFile": {
                "type": "string"
              },
              "toolchainsFile": {
                "type": "string"
              },
              "mavenHome": {
                "type": "string"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "profiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "markdownDescription": "%config.maven.configurations%",
          "scope": "machine-overridable"
        },
        "batlehub.java.maven.activeConfiguration": {
          "type": "string",
          "markdownDescription": "%config.maven.activeConfiguration%",
          "scope": "resource"
        },
        "batlehub.java.maven.activeProfiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "markdownDescription": "%config.maven.activeProfiles%",
          "scope": "resource"
        },
        "batlehub.java.registry.enabled": {
          "type": "string",
          "enum": [
            "ask",
            "true",
            "false"
          ],
          "default": "ask",
          "markdownDescription": "%config.registry.enabled%",
          "scope": "resource"
        },
        "batlehub.java.registry.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.registry.url%",
          "scope": "machine-overridable"
        },
        "batlehub.java.coexistence": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.coexistence%",
          "scope": "resource"
        },
        "batlehub.java.experimental": {
          "type": "object",
          "default": {},
          "properties": {
            "intellijImport": {
              "type": "boolean"
            }
          },
          "markdownDescription": "%config.experimental%",
          "scope": "resource"
        }
      }
    },
    "commands": [
      {
        "command": "batlehub.java.detect",
        "title": "%cmd.detect%",
        "category": "Java",
        "icon": "$(refresh)"
      },
      {
