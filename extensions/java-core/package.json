                            "exit": {
                              "type": "integer",
                              "description": "%debug.run.probe.exit%"
                            },
                            "timeoutMs": {
                              "type": "integer",
                              "default": 60000
                            },
                            "intervalMs": {
                              "type": "integer",
                              "default": 500
                            }
                          }
                        },
                        "stop": {
                          "type": "object",
                          "properties": {
                            "cmd": {
                              "type": "string"
                            },
                            "args": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
