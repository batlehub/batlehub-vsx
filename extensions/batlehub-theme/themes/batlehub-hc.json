{
  "$schema": "vscode://schemas/color-theme",
  "name": "BatleHub High Contrast",
  "type": "hcDark",
  "semanticHighlighting": true,
  "colors": {
    "activityBar.activeBorder": "#fe6c66",
    "activityBar.background": "#030001",
    "activityBar.foreground": "#f6e6e4",
    "activityBar.inactiveForeground": "#b8938d",
    "activityBarBadge.background": "#fe6c66",
    "activityBarBadge.foreground": "#080202",
    "badge.background": "#fe6c66",
    "badge.foreground": "#080202",
    "button.background": "#fe6c66",
    "button.border": "#885b57",
    "button.foreground": "#080202",
    "button.secondaryBackground": "#010000",
    "button.secondaryForeground": "#f6e6e4",
    "button.secondaryHoverBackground": "#140809",
    "chat.inputWorkingBorderColor3": "#676767",
    "checkbox.border": "#885b57",
    "contrastActiveBorder": "#fdc436",
    "contrastBorder": "#885b57",
    "debugConsole.warningForeground": "#49b143",
    "debugExceptionWidget.border": "#bd342d",
    "descriptionForeground": "#b8938d",
    "diffEditor.move.border": "#a2a2a29c",
    "disabledForeground": "#b8938d",
    "dropdown.background": "#010000",
    "dropdown.border": "#885b57",
    "editor.background": "#030001",
    "editor.findRangeHighlightBorder": "#fef4ee66",
    "editor.foreground": "#f6e6e4",
    "editor.inlineValuesForeground": "#ffffffb2",
    "editor.lineHighlightBackground": "#140809",
    "editor.snippetFinalTabstopHighlightBorder": "#676767",
    "editorBracketHighlight.foreground4": "#fdfdfd5a",
    "editorBracketHighlight.foreground5": "#fdfdfd5a",
    "editorBracketHighlight.foreground6": "#fdfdfd5a",
    "editorCodeLens.foreground": "#b8938d",
    "editorCursor.foreground": "#f6e6e4",
    "editorError.foreground": "#f48771",
    "editorGroup.border": "#885b57",
    "editorGutter.commentDraftGlyphForeground": "#5f5f5f",
    "editorGutter.commentGlyphForeground": "#5f5f5f",
    "editorGutter.commentUnresolvedGlyphForeground": "#5f5f5f",
    "editorGutter.itemGlyphForeground": "#5f5f5f",
    "editorGutter.modifiedBackground": "#e8894a",
    "editorIndentGuide.background": "#885b57",
    "editorLineNumber.foreground": "#b8938d",
    "editorOverviewRuler.addedForeground": "#7bb54b99",
    "editorOverviewRuler.border": "#f7f7f766",
    "editorOverviewRuler.errorForeground": "#f48771",
    "editorOverviewRuler.modifiedForeground": "#54b0d999",
    "editorOverviewRuler.rangeHighlightForeground": "#4eabfe99",
    "editorRuler.foreground": "#885b57",
    "editorSuggestWidget.focusHighlightForeground": "#919cab",
    "editorSuggestWidget.selectedIconForeground": "#56606e",
    "editorSuggestWidgetStatus.foreground": "#ffffff99",
    "editorWarning.foreground": "#e8894a",
    "editorWhitespace.foreground": "#f7f8f665",
    "editorWidget.background": "#010000",
    "editorWidget.border": "#885b57",
    "errorForeground": "#f48771",
    "focusBorder": "#fdc436",
    "foreground": "#f6e6e4",
    "gitDecoration.modifiedResourceForeground": "#e8894a",
    "inlineEdit.gutterIndicator.primaryBorder": "#676767",
    "inlineEdit.gutterIndicator.successfulBorder": "#676767",
    "input.background": "#010000",
    "input.border": "#885b57",
    "input.foreground": "#f6e6e4",
    "inputValidation.errorBorder": "#f48771",
    "list.activeSelectionBackground": "#140809",
    "list.activeSelectionForeground": "#f6e6e4",
    "list.errorForeground": "#f48771",
    "list.hoverBackground": "#140809",
    "list.invalidItemForeground": "#ba9706",
    "list.warningForeground": "#e8894a",
    "markdownAlert.important.foreground": "#b988df",
    "mergeEditor.conflict.handledUnfocused.border": "#ffffff62",
    "mergeEditor.conflict.unhandledUnfocused.border": "#ffc2787a",
    "notifications.background": "#030001",
    "notifications.border": "#5e6876",
    "panel.background": "#030001",
    "panel.border": "#885b57",
    "panelTitle.activeBorder": "#fe6c66",
    "panelTitle.activeForeground": "#f6e6e4",
    "panelTitle.inactiveForeground": "#b8938d",
    "ports.iconRunningProcessForeground": "#5f5f5f",
    "quickInput.background": "#010000",
    "quickInput.foreground": "#f6e6e4",
    "scmGraph.historyItemHoverLabelForeground": "#5f5f5f",
    "sideBar.background": "#030001",
    "sideBar.border": "#885b57",
    "sideBarSectionHeader.foreground": "#b8938d",
    "statusBar.background": "#010000",
    "statusBar.foreground": "#b8938d",
    "statusBarItem.prominentBackground": "#140809",
    "statusBarItem.prominentForeground": "#f6e6e4",
    "statusBarItem.warningForeground": "#e8894a",
    "tab.activeBackground": "#140809",
    "tab.activeBorder": "#fe6c66",
    "tab.activeForeground": "#f6e6e4",
    "tab.inactiveForeground": "#b8938d",
    "terminal.ansiRed": "#f48771",
    "terminal.ansiYellow": "#e8894a",
    "terminal.background": "#030001",
    "terminalOverviewRuler.border": "#f7f7f766",
    "textBlockQuote.background": "#010000",
    "textBlockQuote.border": "#885b57",
    "textLink.foreground": "#fe6c66",
    "textPreformat.background": "#010000",
    "textPreformat.foreground": "#e8894a",
    "textSeparator.foreground": "#676767",
    "titleBar.activeBackground": "#030001",
    "titleBar.activeForeground": "#f6e6e4",
    "tree.indentGuidesStroke": "#885b57",
    "widget.border": "#885b57"
  },
  "semanticTokenColors": {
    "newOperator": "#f8f8f2",
    "stringLiteral": "#f1fa8c",
    "customLiteral": "#50fa7b",
    "numberLiteral": "#ff6229",
    "class": "#8be9fd",
    "interface": "#8be9fd",
    "enum": "#8be9fd",
    "record": "#8be9fd",
    "typeParameter": "#8be9fd",
    "namespace": "#8be9fd",
    "method.declaration": {
      "foreground": "#50fa7b",
      "bold": true
    },
    "class.declaration": {
      "foreground": "#50fa7b",
      "bold": true
    },
    "method": "#50fa7b",
    "function": "#50fa7b",
    "keyword": "#ff79c6",
    "modifier": "#ff79c6",
    "variable": "#f8f8f2",
    "property": "#f8f8f2",
    "parameter": "#f8f8f2",
    "operator": "#ff79c6",
    "comment": {
      "foreground": "#8395c9",
      "italic": true
    },
    "string": "#e8894a",
    "annotation": "#e8894a",
    "annotationMember": "#e8894a",
    "number": "#ff6229",
    "enumMember": "#ff6229"
  },
  "tokenColors": [
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "string meta.image.inline.markdown",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "comment",
      "settings": {
        "foreground": "#8395c9"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "constant.regexp",
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "scope": "constant.character",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": [
        "entity.name.tag.css",
        "entity.name.tag.less"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "source.css entity.other.attribute-name.class",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.parent-selector.css",
        "entity.other.attribute-name.parent.less",
        "source.css entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element.css",
        "source.css.less entity.other.attribute-name.id",
        "entity.other.attribute-name.scss"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#8be9fd"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "name": "brackets of XML/HTML tags",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8395c9"
      }
    },
    {
      "scope": "meta.preprocessor",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "meta.preprocessor.string",
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": "meta.preprocessor.numeric",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "meta.structure.dictionary.key.python",
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "storage.modifier",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": "string.tag",
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": "string.value",
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "scope": [
        "support.type.vendored.property-name",
        "support.type.property-name",
        "source.css variable",
        "source.coffee.embedded"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "keyword.control",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "scope": "support.function.git-rebase",
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "scope": "constant.sha.git-rebase",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "name": "coloring of the Java import and package identifiers",
      "scope": [
        "storage.modifier.import.java",
        "variable.language.wildcard.java",
        "storage.modifier.package.java"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "coloring of the TS this",
      "scope": "variable.language.this",
      "settings": {
        "foreground": "#ff6229"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member"
      ],
      "settings": {
        "foreground": "#50fa7b"
      }
    },
    {
      "name": "Types declaration and references",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.name.class",
        "storage.type.cs",
        "storage.type.generic.cs",
        "storage.type.modifier.cs",
        "storage.type.variable.cs",
        "storage.type.annotation.java",
        "storage.type.generic.java",
        "storage.type.java",
        "storage.type.object.array.java",
        "storage.type.primitive.array.java",
        "storage.type.primitive.java",
        "storage.type.token.java",
        "storage.type.groovy",
        "storage.type.annotation.groovy",
        "storage.type.parameters.groovy",
        "storage.type.generic.groovy",
        "storage.type.object.array.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.groovy"
      ],
      "settings": {
        "foreground": "#8be9fd"
      }
    },
    {
      "name": "Types declaration and references, TS grammar specific",
      "scope": [
        "meta.type.cast.expr",
        "meta.type.new.expr",
        "support.constant.math",
        "support.constant.dom",
        "support.constant.json",
        "entity.other.inherited-class",
        "punctuation.separator.namespace.ruby"
      ],
      "settings": {
        "foreground": "#8be9fd"
      }
    },
    {
      "name": "Control flow / Special keywords",
      "scope": [
        "keyword.control",
        "source.cpp keyword.operator.new",
        "source.cpp keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "Variable and parameter name",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable"
      ],
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "name": "Object keys, TS grammar specific",
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "name": "CSS property value",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "name": "HC Search Editor context line override",
      "scope": "meta.resultLinePrefix.contextLinePrefix.search",
      "settings": {
        "foreground": "#50fa7b"
      }
    },
    {
      "name": "Declarations",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#50fa7b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#8395c9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Literals and annotations",
      "scope": [
        "string",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#e8894a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f48771"
      }
    }
  ]
}
