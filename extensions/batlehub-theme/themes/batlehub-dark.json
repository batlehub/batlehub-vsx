    {
      "scope": "invalid",
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#fe5368"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#fe5368"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#ff79c6"
      }
    },
    {
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": "markup.changed",
      "settings": {
        "foreground": "#fe5368"
      }
