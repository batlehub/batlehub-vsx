    "editorWarning.foreground": "#e8894a",
    "editorWhitespace.foreground": "#fcfdfb33",
    "editorWidget.background": "#010000",
    "editorWidget.border": "#885b57",
    "errorForeground": "#f05129",
    "extensionButton.border": "#f2f2f235",
