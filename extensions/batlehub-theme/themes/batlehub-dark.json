    "quickInput.foreground": "#f4e4e2",
    "scmGraph.historyItemHoverLabelForeground": "#5f5f5f",
    "settings.dropdownListBorder": "#fcfcfc33",
    "settings.headerBorder": "#92929259",
    "settings.sashBorder": "#92929259",
    "sideBar.background": "#030001",
    "sideBar.border": "#463230",
    "sideBarSectionHeader.foreground": "#a07c76",
    "statusBar.background": "#010000",
    "statusBar.foreground": "#a07c76",
    "statusBarItem.prominentBackground": "#140809",
    "statusBarItem.prominentForeground": "#f4e4e2",
    "statusBarItem.warningForeground": "#e8894a",
