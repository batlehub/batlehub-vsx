  "semanticTokenColors": {
    "newOperator": "#ff79c6",
    "stringLiteral": "#f1fa8c",
    "customLiteral": "#50fa7b",
    "numberLiteral": "#fe5368",
    "class": "#8be9fd",
    "interface": "#8be9fd",
    "enum": "#8be9fd",
    "record": "#8be9fd",
    "typeParameter": "#8be9fd",
    "namespace": "#8be9fd",
    "method.declaration": {
      "foreground": "#50fa7b",
      "bold": true
    },
    "class.declaration": {
      "foreground": "#50fa7b",
      "bold": true
    },
    "method": "#50fa7b",
    "function": "#50fa7b",
    "keyword": "#ff79c6",
    "modifier": "#ff79c6",
    "variable": "#f8f8f2",
    "property": "#f8f8f2",
    "parameter": "#f8f8f2",
    "operator": "#ff79c6",
    "comment": {
      "foreground": "#6373a6",
      "italic": true
    },
    "string": "#e8894a",
    "annotation": "#e8894a",
    "annotationMember": "#e8894a",
    "number": "#fe5368",
    "enumMember": "#fe5368"
  },
  "tokenColors": [
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "string meta.image.inline.markdown",
        "variable.legacy.builtin.python"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "header",
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": "comment",
      "settings": {
        "foreground": "#6373a6"
      }
    },
    {
      "scope": "constant.language",
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "variable.other.enummember",
        "keyword.operator.plus.exponent",
        "keyword.operator.minus.exponent"
      ],
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": "constant.regexp",
      "settings": {
        "foreground": "#6373a6"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": [
        "entity.name.tag.css",
        "entity.name.tag.less"
      ],
      "settings": {
        "foreground": "#ffb86c"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "source.css entity.other.attribute-name.class",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.parent-selector.css",
        "entity.other.attribute-name.parent.less",
        "source.css entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element.css",
        "source.css.less entity.other.attribute-name.id",
        "entity.other.attribute-name.scss"
