        "foreground": "#8be9fd"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "name": "brackets of XML/HTML tags",
      "scope": "punctuation.definition.tag",
      "settings": {
        "foreground": "#6373a6"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": "meta.preprocessor.string",
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": "meta.preprocessor.numeric",
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": "meta.structure.dictionary.key.python",
      "settings": {
        "foreground": "#f8f8f2"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": "storage.type",
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": [
        "storage.modifier",
        "keyword.operator.noexcept"
      ],
      "settings": {
        "foreground": "#fe5368"
      }
    },
    {
      "scope": [
        "string",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": "string.tag",
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": "string.value",
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": "string.regexp",
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
