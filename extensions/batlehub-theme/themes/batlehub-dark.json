    "tab.activeBorder": "#ff343d",
    "tab.activeForeground": "#f4e4e2",
    "tab.border": "#383839",
    "tab.inactiveForeground": "#a07c76",
    "tab.unfocusedInactiveModifiedBorder": "#87d3fe40",
    "terminal.ansiRed": "#f05129",
    "terminal.ansiYellow": "#e8894a",
    "terminal.background": "#030001",
    "terminal.border": "#92929259",
    "terminal.initialHintForeground": "#ffffff79",
    "terminalOverviewRuler.border": "#a8a8a84d",
    "testing.coveredBorder": "#dbffa135",
    "testing.uncoveredBorder": "#ffefec35",
    "textBlockQuote.background": "#010000",
    "textBlockQuote.border": "#463230",
    "textLink.foreground": "#ff343d",
    "textPreformat.background": "#010000",
    "textPreformat.foreground": "#e8894a",
    "textSeparator.foreground": "#ffffff33",
    "titleBar.activeBackground": "#030001",
    "titleBar.activeForeground": "#f4e4e2",
    "titleBar.inactiveForeground": "#d4d4d499",
    "tree.indentGuidesStroke": "#463230",
    "tree.tableColumnsBorder": "#f7f7f734",
    "welcomePage.tileBorder": "#ffffff33",
    "widget.border": "#885b57"
  },
  "semanticTokenColors": {
    "class": "#f4e4e2",
    "interface": "#f4e4e2",
    "enum": "#f4e4e2",
    "record": "#f4e4e2",
    "typeParameter": "#f4e4e2",
    "namespace": "#f4e4e2",
    "class.declaration": {
      "foreground": "#f4e4e2",
      "bold": true
    },
    "method.declaration": {
      "foreground": "#f4e4e2",
      "bold": true
    },
    "method": "#a07c76",
    "property": "#a07c76",
    "parameter": "#a07c76",
    "variable": "#a07c76",
    "keyword": "#a07c76",
    "modifier": "#a07c76",
    "operator": "#a07c76",
    "comment": {
      "foreground": "#a07c76",
      "italic": true
    },
    "string": "#e8894a",
    "number": "#e8894a",
    "annotation": "#e8894a",
    "annotationMember": "#e8894a",
    "enumMember": "#e8894a"
  },
  "tokenColors": [
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#f4e4e2"
      }
    },
    {
      "name": "Declarations",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#f4e4e2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Everything ordinary",
      "scope": [
        "keyword",
        "storage",
        "variable",
        "punctuation"
      ],
      "settings": {
        "foreground": "#a07c76"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#a07c76",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Literals and annotations",
      "scope": [
        "string",
        "constant.numeric",
        "storage.type.annotation",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#e8894a"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f05129"
      }
    }
  ]
}
