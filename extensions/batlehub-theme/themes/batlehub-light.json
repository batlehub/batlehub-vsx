  "semanticTokenColors": {
    "class": "#1f1212",
    "interface": "#1f1212",
    "enum": "#1f1212",
    "record": "#1f1212",
    "typeParameter": "#1f1212",
    "namespace": "#1f1212",
    "class.declaration": {
      "foreground": "#1f1212",
      "bold": true
    },
    "method.declaration": {
      "foreground": "#1f1212",
      "bold": true
    },
    "method": "#674a47",
    "property": "#674a47",
    "parameter": "#674a47",
    "variable": "#674a47",
    "keyword": "#674a47",
    "modifier": "#674a47",
    "operator": "#674a47",
    "comment": {
      "foreground": "#674a47",
      "italic": true
    },
    "string": "#974c12",
    "number": "#974c12",
    "annotation": "#974c12",
    "annotationMember": "#974c12",
    "enumMember": "#974c12"
  },
  "tokenColors": [
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#1f1212"
      }
    },
    {
      "name": "Declarations",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#1f1212",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Everything ordinary",
      "scope": [
        "keyword",
        "storage",
        "variable",
        "punctuation"
      ],
      "settings": {
        "foreground": "#674a47"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#674a47",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Literals and annotations",
      "scope": [
        "string",
        "constant.numeric",
        "storage.type.annotation",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#974c12"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#dd1300"
      }
    }
  ]
}
