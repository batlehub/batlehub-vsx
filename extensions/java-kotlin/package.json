{
  "name": "java-kotlin",
  "displayName": "BatleHub Java: Kotlin",
  "description": "Kotlin and the Gradle Kotlin DSL through JetBrains' Kotlin language server — downloaded on first use, run on its own Java, the project built on the JDK BatleHub Java resolved (RFC 0008).",
  "version": "0.1.0",
  "publisher": "batlehub",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/batleforc/batlehub-vsx" },
  "homepage": "https://github.com/batleforc/batlehub-vsx/tree/main/extensions/java-kotlin",
  "icon": "media/icon.png",
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Programming Languages"],
  "keywords": ["kotlin", "gradle", "kts", "batlehub", "java"],
  "extensionKind": ["workspace"],
  "extensionDependencies": ["batlehub.java-core"],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": ["onLanguage:kotlin", "workspaceContains:**/*.kt", "workspaceContains:**/*.gradle.kts"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": "limited", "description": "%capabilities.untrusted%" },
    "virtualWorkspaces": false
  },
  "contributes": {
    "languages": [
      { "id": "kotlin", "aliases": ["Kotlin", "kotlin"], "extensions": [".kt", ".kts"] }
    ],
    "configuration": {
      "title": "BatleHub Java: Kotlin",
      "properties": {
        "batlehub.java.kotlin.enabled": { "type": "boolean", "default": true, "description": "%cfg.enabled%" },
        "batlehub.java.kotlin.server.xmx": { "type": "string", "default": "1G", "description": "%cfg.xmx%" },
        "batlehub.java.kotlin.server.args": { "type": "array", "items": { "type": "string" }, "default": [], "description": "%cfg.args%" },
        "batlehub.java.kotlin.server.version": { "type": "string", "default": "latest", "pattern": "^(latest|\\d+\\.\\d+\\.\\d+)$", "description": "%cfg.version%" },
        "batlehub.java.kotlin.server.home": { "type": "string", "default": "", "scope": "machine", "description": "%cfg.home%" }
      }
    },
    "commands": [
      { "command": "batlehub.java.kotlin.restart", "title": "%cmd.restart%", "category": "Java" },
      { "command": "batlehub.java.kotlin.showLog", "title": "%cmd.showLog%", "category": "Java", "icon": "$(output)" }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src test && prettier --check \"src/**/*.ts\" \"test/**/*.ts\" esbuild.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" esbuild.mjs",
    "test": "vitest run",
    "package": "node esbuild.mjs && vsce package --no-dependencies --skip-license -o java-kotlin.vsix"
  },
  "dependencies": {
    "@batlehub/java-rules": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "vscode-languageclient": "^9.0.1"
  }
}
