{
  "name": "batlehub-vsx-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r --filter './extensions/*' run build",
    "test": "pnpm -r --filter './extensions/*' --filter './engine' run test",
    "lint": "pnpm -r --filter './extensions/*' --filter './packages/*' --filter './engine' run lint",
    "typecheck": "pnpm -r --filter './extensions/*' --filter './packages/*' --filter './engine' run typecheck",
    "package": "pnpm -r --filter './extensions/*' run package"
  }
}
