{
  "name": "batlehub-vsx-workspace",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "pnpm -r --filter './extensions/*' run build",
    "test": "pnpm -r --filter './extensions/*' run test",
    "lint": "pnpm -r --filter './extensions/*' run lint",
    "typecheck": "pnpm -r --filter './extensions/*' run typecheck",
    "package": "pnpm -r --filter './extensions/*' run package"
  }
}
