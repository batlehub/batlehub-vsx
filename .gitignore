# Task internal cache (checksums/fingerprints)
.task/

# Claude Code per-user local settings
.claude/settings.local.json

# Build artifacts
node_modules/
target/
dist/

# Local env files
.env
.env.local

# Extension build output and packages
extensions/*/dist/
extensions/*/*.vsix
coverage/

# The heavy suite's working directories (editor data dirs, screenshots, logs)
tests/heavy/work/
docs/.vitepress/cache/
docs/.vitepress/dist/

# Layer 2 compiled tests
extensions/*/test-host/out/

extensions/*/.vscode-test/
extensions/*/THIRD-PARTY.md

# The Groovy language server jar: fetched by task groovy:fetch, shipped in the VSIX, never committed
extensions/java-groovy/server/*.jar

# The JDT bundle (task jdt:build); built, never committed
extensions/*/jdt/*.jar
jdt/*/target/
